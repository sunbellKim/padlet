# Copy to .env.local and fill in your own values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only secrets (never add a NEXT_PUBLIC_ prefix)
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# bcrypt hash. In .env.local escape every "$" as "\$" (Next.js expands $VARS).
# In the Vercel dashboard paste the hash as-is, without backslashes.
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH
# At least 32 random characters
ADMIN_SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET
